
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write access to the 'users' collection for the authenticated user matching the document ID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'agentTasks' collection
    match /agentTasks/{taskId} {
      // Allow authenticated users to read tasks belonging to them
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow authenticated users to CREATE tasks if the 'userId' field in the
      // new document matches their own authentication UID.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Allow authenticated users to UPDATE tasks belonging to them.
      // Optionally, restrict which fields can be updated (e.g., only status, result, error).
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
                 // Example: Restrict fields allowed for update
                 // && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'error', 'updatedAt', 'details']);


      // Allow authenticated users to DELETE tasks belonging to them (optional)
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

     // Catch-all rule for any other path (optional, but good practice to deny by default)
     match /{document=**} {
       allow read, write: if false;
     }
  }
}
