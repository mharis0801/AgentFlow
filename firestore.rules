
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for agentTasks collection
    match /agentTasks/{taskId} {
      // Allow authenticated users to CREATE tasks if the task's userId matches their own UID
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Allow authenticated users to READ, UPDATE, and DELETE their own tasks
      // Check the existing resource's data for read, update, delete
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Optional: Add more specific update rules if needed, e.g., restrict updatable fields
      // allow update: if request.auth.uid == resource.data.userId
      //                && request.resource.data.keys().hasOnly(['status', 'result', 'error', 'details', 'updatedAt']); // Adjust fields as necessary
    }
  }
}
